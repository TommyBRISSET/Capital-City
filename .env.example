# ==============================================================================
# CAPITAL CITY — Configuration d'environnement (EXEMPLE SANS SECRETS RÉELS)
# Copiez ce fichier vers .env (et .env.local si souhaité) avant de démarrer.
# ==============================================================================

# Identité du produit (configurable)
NEXT_PUBLIC_APP_NAME="Capital City"
NODE_ENV="development"

# URLs publiques et internes
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_REALTIME_URL="http://localhost:4000"
REALTIME_PORT=4000
WEB_PORT=3000
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Base de données PostgreSQL (Docker Compose par défaut ou démon PGlite embarqué)
DATABASE_URL="postgresql://capitalcity:capitalcity_dev_pwd@127.0.0.1:5432/capital_city?schema=public&pgbouncer=true"
POSTGRES_USER="capitalcity"
POSTGRES_PASSWORD="capitalcity_dev_pwd"
POSTGRES_DB="capital_city"
POSTGRES_PORT=5432

# Redis (Présence, coordination des salles et limitation de débit)
REDIS_URL="redis://127.0.0.1:6379"
REDIS_PORT=6379
# Si true, bascule gracieusement en mémoire locale lorsque Redis n'est pas joignable en dev/test
REDIS_OPTIONAL_FALLBACK="true"

# Sécurité & Sessions (Remplacer impérativement en production par une clé aléatoire >= 32 octets)
SESSION_SECRET="replace-me-in-local-env-with-at-least-32-random-bytes-0123456789"
SESSION_COOKIE_NAME="cc_session"
SESSION_MAX_AGE_SECONDS=604800

# Paramètres opérationnels du serveur temps réel
SNAPSHOT_EVERY_EVENTS=5
DISCONNECT_GRACE_SECONDS=120
RATE_LIMIT_MAX_COMMANDS_PER_10S=35
LOG_LEVEL="info"
